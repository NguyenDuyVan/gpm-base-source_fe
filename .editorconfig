# Top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Markdown (giữ lại whitespace cuối dòng, cần cho line break)
[*.md]
trim_trailing_whitespace = false

# JSON, YAML, TS/JS config files
[*.{json,yml,yaml,ts,tsx,js,jsx}]
indent_style = space
indent_size = 2

# .env files
[*.env]
end_of_line = lf
insert_final_newline = false
